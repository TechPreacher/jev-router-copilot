#!/usr/bin/env bash
# jevcp: size a prompt with Jev, then run Copilot CLI on the model Jev picked (Tier 3 fallback).
#   jevcp [-i] [--] "prompt"     -i starts an interactive session with the prompt (default: one-shot -p)
# Routes the main model, which the Tier 1 hook cannot do. When the router is OFF, or Jev keeps the
# prompt with the main model, copilot runs on its default model. The prompt is passed on argv, so it is
# visible to other users on this machine through ps while copilot runs.
# Installed to $COPILOT_HOME/jev-router/bin/jevcp, next to jev_copilot.py.
set -eu

JR="$(cd "$(dirname "$0")/.." && pwd)"
mode="-p"
while [ $# -gt 0 ]; do
  case "$1" in
    -i) mode="-i"; shift ;;
    --) shift; break ;;
    -h|--help) echo 'usage: jevcp [-i] [--] "prompt"'; exit 0 ;;
    -*) echo "jevcp: unknown option $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { echo 'usage: jevcp [-i] [--] "prompt"' >&2; exit 2; }
prompt="$*"

# One call sizes the prompt and records the decision. Any failure means: default model.
line="$(python3 -I "$JR/jev_copilot.py" size "$prompt" 2>/dev/null)" || line="local - -"
read -r route model effort <<EOF
$line
EOF
route="${route:-local}"; model="${model:--}"; effort="${effort:--}"

extra=()
case "$route" in
  tiny|everyday|large|hardest)
    echo "jevcp: $route -> $model" >&2
    extra+=(--model "$model")
    [ "$effort" = "-" ] || extra+=(--reasoning-effort "$effort") ;;
  *)
    echo "jevcp: $route -> default model" >&2 ;;
esac

# The hook would size this prompt a second time inside copilot. Tell it not to.
export JEV_ROUTER_PRESIZED=1
exec copilot ${extra[@]+"${extra[@]}"} "$mode" "$prompt"
